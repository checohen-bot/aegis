# Aegis local/sandbox environment variables (RFC-0001 walking skeleton).
# Copy to `.env` for docker compose to pick up overrides. These are local-only
# development defaults — there are NO real secrets here. Authentication and real
# secret management are deferred per ADR-0015.

# --- PostgreSQL (db service) ---
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegis

# --- API service ---
# Connection string the API uses to reach Postgres inside the compose network.
# (Host is the `db` service name, not localhost.)
DATABASE_URL=postgresql+psycopg2://aegis:aegis@db:5432/aegis
LOG_LEVEL=INFO

# --- Web service ---
# Base URL the browser uses to call the API. Inlined into the web bundle at
# build time, so it must be reachable from the user's browser (localhost).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
